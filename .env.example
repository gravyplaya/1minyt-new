# Optional. Absolute path to the SQLite DB file. Defaults to ./data/1minyt.db
# DATABASE_PATH=/Users/you/wherever/1minyt.db

# Public origin (used to compose channel / video URLs in the UI). Default http://localhost:3000
NEXT_PUBLIC_ORIGIN=

# Google OAuth client credentials (https://console.cloud.google.com → APIs & Services → Credentials).
# Create an OAuth 2.0 Client ID of type "Web application".
# Authorized redirect URI must match YOUTUBE_REDIRECT_URI below.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# TAV-4: 1-Click Instant Summaries.
# OpenRouter API key (https://openrouter.ai/keys) — routes to many models through one API.
OPENROUTER_API_KEY=
# Optional: override the model used for summaries. Default: openai/gpt-oss-20b:free
# SUMMARY_MODEL=openai/gpt-oss-20b:free

# TAV-5: Chat with Video (RAG over transcripts).
# Uses the same OPENROUTER_API_KEY for chat completions.
# Embeddings are generated locally (hashing vectorizer) — no API key or hosted service needed.
# Optional: override the chat model used for RAG answers. Default: openai/gpt-oss-20b:free
# CHAT_MODEL=openai/gpt-oss-20b:free