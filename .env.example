DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

YOUTUBE_CLIENT_ID=...apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/oauth/callback

OPENROUTER_API_KEY=...
# Optional — override the default model:
# SUMMARY_MODEL=openai/gpt-oss-20b:free
# CHAT_MODEL=openai/gpt-oss-20b:free

# TAV-19: Whisper speech-to-text fallback for uncaptioned videos.
# When YouTube has no captions, the audio is downloaded (yt-dlp) and transcribed.
# Two interchangeable backends — set whichever one you have available.
#
# Option A: OpenAI Whisper API (cloud). Requires an OpenAI API key.
# OPENAI_API_KEY=sk-...
# WHISPER_MODEL=whisper-1
#
# Option B: whisper.cpp (self-hosted, runs offline). Point at a whisper.cpp
# `main`/`whisper-cli` binary and a .bin model file.
# WHISPER_CPP_BINARY=/path/to/whisper-cli
# WHISPER_MODEL_PATH=/path/to/ggml-medium.bin
